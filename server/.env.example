# Copy this file to .env and adjust. .env is git-ignored.

# PostgreSQL connection string: postgres://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgres://postgres:postgres@localhost:5432/juakali

# Set to "true" for hosted databases that require SSL (Render, Neon, Supabase, Railway...)
DATABASE_SSL=false

# Use a long random string in production
SESSION_SECRET=change-me

PORT=3000

# Production (Render): URL(s) of the deployed frontend allowed to call this API
# CORS_ORIGIN=https://your-app.vercel.app
