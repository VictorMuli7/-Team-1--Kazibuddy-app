
# PostgreSQL connection string, e.g. postgres://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgres://USER:PASSWORD@HOST:PORT/DATABASE


DATABASE_SSL=false


SESSION_SECRET=change-me

PORT=3000

# Production (Render): URL(s) of the deployed frontend allowed to call this API
# CORS_ORIGIN=https://your-app.vercel.app

# Replace with unique keys before starting the API:
# API_KEYS=organ-donation:partner:<random-key>,web-app:web:<random-key>
API_KEYS=
RATE_LIMIT_MAX=4

# HospitalQ partner API version (see services/partner.js). v1 = current behaviour.
HOSPITALQ_VERSION=v1

# Date the deprecated v1 artisan API stops working (sent in the Sunset header).
# V1_SUNSET=2026-11-13
